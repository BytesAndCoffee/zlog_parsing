DB_HOST=database-host
DB_PORT=3306
DB_USERNAME=database-user
DB_PASSWORD=database-password
DB_NAME=znc
# Test databases only; production should keep TLS verification enabled.
DB_SSL_DISABLED=false
TELEGRAM_BOT_TOKEN=telegram-bot-token
TELEGRAM_CHAT_ID=telegram-chat-id

# Production defaults. Lower these values only for tests.
DB_RETRY_SECONDS=3600
CATCHUP_NOTIFICATION_INTERVAL_SECONDS=15
CATCHUP_BATCH_SIZE=250
STATE_DB_PATH=/var/lib/zlog/recovery.sqlite3
DATABASE_SLEEP_STATE_FILE=/var/lib/zlog/database-sleeping
